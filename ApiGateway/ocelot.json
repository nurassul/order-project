{
  "Routes" : [
    // Получение страницу заказов
    {
      "UpstreamPathTemplate": "/api/orders",
      "UpstreamHttpMethod": ["GET"],
      "DownstreamPathTemplate": "/api/orders",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "order-service",
          "Port": 8080
        }
      ]
    },
    
    // Cоздание заказа
    {
      "UpstreamPathTemplate": "/api/orders",
      "UpstreamHttpMethod": ["POST"],
      "DownstreamPathTemplate": "/api/orders",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "order-service",
          "Port": 8080
        }
      ]
    },
    
    // Получить заказ по ID
    {
      "UpstreamPathTemplate": "/api/orders/{id}",
      "UpstreamHttpMethod": ["GET"],
      "DownstreamPathTemplate": "/api/orders/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "order-service",
          "Port": 8080
        }
      ]
    },
    
    // Обновить поля заказа по ID
    {
      "UpstreamPathTemplate": "/api/orders/{id}",
      "UpstreamHttpMethod": ["PUT"],
      "DownstreamPathTemplate": "/api/orders/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "order-service",
          "Port": 8080
        }
      ]
    },

    // Удалить заказ по id
    {
      "UpstreamPathTemplate": "/api/orders/{id}",
      "UpstreamHttpMethod": ["DELETE"],
      "DownstreamPathTemplate": "/api/orders/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "order-service",
          "Port": 8080
        }
      ]
    },
    
    // Получить страницу доставок
    {
      "UpstreamPathTemplate": "/api/deliveries",
      "UpstreamHttpMethod": ["GET"],
      "DownstreamPathTemplate": "/api/deliveries",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "delivery-service",
          "Port": 8080
        }
      ]
    },
    
    // Получить доставку по id
    {
      "UpstreamPathTemplate": "/api/deliveries/{id}",
      "UpstreamHttpMethod": ["GET"],
      "DownstreamPathTemplate": "/api/deliveries/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "delivery-service",
          "Port": 8080
        }
      ]
    },

    // Начать доставку по id
    {
      "UpstreamPathTemplate": "/api/deliveries/{id}/start",
      "UpstreamHttpMethod": ["PATCH"],
      "DownstreamPathTemplate": "/api/deliveries/{id}/start",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "delivery-service",
          "Port": 8080
        }
      ]
    },
    // Завершить доставку по id
    {
      "UpstreamPathTemplate": "/api/deliveries/{id}/confirm",
      "UpstreamHttpMethod": ["PATCH"],
      "DownstreamPathTemplate": "/api/deliveries/{id}/confirm",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "delivery-service",
          "Port": 8080
        }
      ]
    },
    // Отменить доставку по id
    {
      "UpstreamPathTemplate": "/api/deliveries/{id}/cancel",
      "UpstreamHttpMethod": ["PATCH"],
      "DownstreamPathTemplate": "/api/deliveries/{id}/cancel",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "delivery-service",
          "Port": 8080
        }
      ]
    }
  ]
}